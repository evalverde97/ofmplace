const TELEGRAM_SECTIONS=[['PERFORMANCE SNAPSHOT',['onlyfansStatus','monthlyRevenue','currentSubscribers','contentLibrary','notes']],['CREATOR PROFILE',['age','country','english','creatorType','smartphone']],['COLLABORATION PREFERENCES',['countriesBlocked','accountAccess','revenueSplit','dailyWeeklyAvailability','startAvailability','agency','socialMedia','contentType']]];
const TELEGRAM_LABELS=['Onlyfans Status','Monthly Revenue','Current Subscribers','Content Library','Notes / Highlights','Age','Country','English Level','Creator Type','Smartphone','Countries Blocked','Account access','Revenue Split (%)','Availability Day/Week','Start Availability','Currently Working w/Agency','Social Media Set Up','Content Type'];
function perfilTelegram(data){const p=registros().profiles.find(p=>p.id===data.id);if(!p)return {error:'not_found'};if(!p.approved||!p.eligible)return {error:'adult_approved_required'};if(p.revision!==data.revision)return {error:'conflict'};if(!/^\d{1,9}(\.\d{1,2})?$/.test(p.listingPrice)||Number(p.listingPrice)<=0)return {error:'invalid_price'};return p;}
function vistaTelegram(data){const p=perfilTelegram(data);if(p.error)return p;const props=PropertiesService.getScriptProperties();if(!props.getProperty('TELEGRAM_BOT_TOKEN'))return {error:'telegram_setup'};let label=0;const lines=[p.name,''];for(const [title,keys] of TELEGRAM_SECTIONS){if(label)lines.push('⸻');lines.push(title);for(const k of keys){const value=p.details[k].trim();const english=inglesTelegram(value);lines.push((k==='creatorType'?'🖤':'🤍')+' '+TELEGRAM_LABELS[label++]+': '+english);}}lines.push('⸻','COMMERCIAL TERMS','🩵 Listing Price: $'+p.listingPrice+' USD','🩵 Guarantee: 18-day replacement or refund policy');const text=lines.join('\n');if(text.length>4096)return {error:'telegram_text_long'};const draft=Utilities.getUuid();CacheService.getScriptCache().put('tg-draft-'+draft,JSON.stringify({id:p.id,revision:p.revision}),600);return {text,draft,channel:'@dollarsofm',photoCount:p.photos.length};}
function telegramRequest(method,payload,multipart=false){const token=PropertiesService.getScriptProperties().getProperty('TELEGRAM_BOT_TOKEN');if(!token)throw new Error('telegram_setup');const response=UrlFetchApp.fetch('https://api.telegram.org/bot'+token+'/'+method,{method:'post',...(multipart?{payload}:{contentType:'application/json',payload:JSON.stringify(payload)}),muteHttpExceptions:true});const result=JSON.parse(response.getContentText());if(!result.ok){const reason=String(result.description||'').toLowerCase();if(method.startsWith('editMessage')&&reason.includes('message is not modified'))return {unchanged:true};if(reason.includes('message to edit not found')||reason.includes('message_id_invalid'))throw new Error('telegram_message_missing');if(reason.includes("message can't be edited")||result.error_code===403||reason.includes('not enough rights'))throw new Error('telegram_permissions');throw new Error('telegram_rejected');}return result.result;}
function publicarTelegram(data){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const p=perfilTelegram(data);if(p.error)return p;const cache=CacheService.getScriptCache(),raw=cache.get('tg-draft-'+data.draft);if(!raw)return {error:'draft_expired'};const draft=JSON.parse(raw);if(draft.id!==p.id||draft.revision!==p.revision)return {error:'conflict'};if(typeof data.text!=='string'||!data.text.trim()||data.text.length>4096)return {error:'telegram_text_long'};
 const props=PropertiesService.getScriptProperties(),recordKey='tg-published-'+p.id,previous=props.getProperty(recordKey);if(previous&&data.republish!==true){if(data.updateExisting!==true)return {error:'already_published'};const state=JSON.parse(previous);if(!['published','text_sent','photos_incomplete'].includes(state.state)||!state.messageId)return {error:'telegram_uncertain'};try{if(state.mode==='caption'){const parts=captionTelegram(data.text);telegramRequest('editMessageCaption',{chat_id:'@dollarsofm',message_id:state.messageId,caption:parts.caption});if(state.remainderId)telegramRequest('editMessageText',{chat_id:'@dollarsofm',message_id:state.remainderId,text:parts.remainder||'Updated — full profile in the photo description.',link_preview_options:{is_disabled:true}});else if(parts.remainder){const extra=telegramRequest('sendMessage',{chat_id:'@dollarsofm',text:parts.remainder,reply_parameters:{message_id:state.messageId},link_preview_options:{is_disabled:true}});state.remainderId=extra.message_id;props.setProperty(recordKey,JSON.stringify(state));}}else telegramRequest('editMessageText',{chat_id:'@dollarsofm',message_id:state.messageId,text:data.text,link_preview_options:{is_disabled:true}});cache.remove('tg-draft-'+data.draft);return {ok:true,updated:true,url:'https://t.me/dollarsofm/'+state.messageId};}catch(error){return {error:['telegram_message_missing','telegram_permissions'].includes(error.message)?error.message:'telegram_update_failed'};}}
 const me=telegramRequest('getMe',{}),member=telegramRequest('getChatMember',{chat_id:'@dollarsofm',user_id:me.id});if(me.username!=='Dollars_manager_bot'||!(member.status==='creator'||member.status==='administrator'&&member.can_post_messages))return {error:'telegram_permissions'};
 // Reserve before sending. An uncertain network outcome must never silently retry.
 props.setProperty(recordKey,JSON.stringify({state:'sending',at:new Date().toISOString()}));cache.remove('tg-draft-'+data.draft);
 try{let firstId=0,warning='',remainderId=0;const parts=captionTelegram(data.text);if(!p.photos.length){const message=telegramRequest('sendMessage',{chat_id:'@dollarsofm',text:data.text,link_preview_options:{is_disabled:true}});firstId=message.message_id;}
 else{for(let start=0;start<p.photos.length;start+=10){try{const count=Math.min(10,p.photos.length-start),payload={chat_id:'@dollarsofm'},media=[];for(let i=0;i<count;i++){const photo=fotoPerfil(p,start+i);if(photo.error)throw new Error('photo_unavailable');payload['photo'+i]=Utilities.newBlob(Utilities.base64Decode(photo.base64),photo.mime,'photo'+i+'.'+(photo.mime==='image/png'?'png':photo.mime==='image/webp'?'webp':'jpg'));media.push({type:'photo',media:'attach://photo'+i,...(start===0&&i===0?{caption:parts.caption}:{})});}let sent;if(count===1)sent=[telegramRequest('sendPhoto',{chat_id:payload.chat_id,photo:payload.photo0,...(start===0?{caption:parts.caption}:{})},true)];else{payload.media=JSON.stringify(media);sent=telegramRequest('sendMediaGroup',payload,true);}if(!firstId){firstId=sent[0].message_id;props.setProperty(recordKey,JSON.stringify({state:'text_sent',messageId:firstId,mode:'caption'}));}}catch{if(!firstId)throw new Error('telegram_uncertain');warning='photos_incomplete';break;}}
 if(parts.remainder){try{const extra=telegramRequest('sendMessage',{chat_id:'@dollarsofm',text:parts.remainder,reply_parameters:{message_id:firstId},link_preview_options:{is_disabled:true}});remainderId=extra.message_id;}catch{warning='text_incomplete';}}}
 props.setProperty(recordKey,JSON.stringify({state:warning?'photos_incomplete':'published',messageId:firstId,mode:p.photos.length?'caption':'text',remainderId}));return {ok:true,warning,url:'https://t.me/dollarsofm/'+firstId};
 }catch{return {error:'telegram_uncertain'};}
 }finally{lock.releaseLock();}}

function inglesTelegram(value){if(!value)return 'Not provided';const normalized=value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase();const standard={si:'Yes',no:'No',ninguno:'None',ninguna:'None',basico:'Basic',intermedio:'Intermediate',avanzado:'Advanced',fluido:'Fluent',activo:'Active',activa:'Active',inactivo:'Inactive',inactiva:'Inactive',inmediato:'Immediate',inmediata:'Immediate',argentina:'Argentina'};if(standard[normalized])return standard[normalized];if(/^[\d\s.,%$]+$/.test(value))return value;const cache=CacheService.getScriptCache(),key='tg-en-'+versionPerfil([value]),saved=cache.get(key);if(saved)return saved;const translated=LanguageApp.translate(value,'','en');cache.put(key,translated,21600);return translated;}

function captionTelegram(text){if(text.length<=1024)return {caption:text,remainder:''};let split=text.lastIndexOf('\n',1000);if(split<1)split=1000;return {caption:text.slice(0,split),remainder:text.slice(split).trimStart()};}
